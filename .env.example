# Copy this file to `.env` and fill in your own values. `.env` is git-ignored: NEVER put real keys in this example file.

# PostgreSQL 16 + PostGIS (Supabase: Connect -> Session/Transaction pooler).
# URL-encode special characters in the password: @ -> %40, # -> %23, ) -> %29, / -> %2F
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings -> API)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-or-publishable-key>"
# Server-only: rollback on failed registration, logout, password reset, storage. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-or-secret-key>"

# Shared secret for cron endpoints (/api/v1/internal/cron/*), min 16 chars (e.g. `openssl rand -hex 24`)
CRON_SECRET="<long-random-string>"

# Seed only: first Super Admin (create the user in Supabase Auth first, then paste its UUID as the auth id)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_AUTH_ID=""
