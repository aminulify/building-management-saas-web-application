{
  "name": "amaderghor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:e2e": "tsx --env-file=.env scripts/smoke.ts",
    "db:seed": "tsx --env-file=.env prisma/seed/index.ts",
    "db:seed:listings": "tsx --env-file=.env prisma/seed/demo-listings.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed/demo-owner.ts",
    "verify:tenants": "tsx --env-file=.env scripts/verify-tenants.ts",
    "verify:rent": "tsx --env-file=.env scripts/verify-rent.ts",
    "verify:findhome": "tsx --env-file=.env scripts/verify-findhome.ts",
    "db:seed:past": "tsx --env-file=.env prisma/seed/demo-past-tenants.ts",
    "db:seed:tenant": "tsx --env-file=.env prisma/seed/demo-tenant-login.ts",
    "db:seed:user": "tsx --env-file=.env prisma/seed/demo-user-login.ts",
    "clean:test": "tsx --env-file=.env scripts/smoke.ts --sweep",
    "db:seed:admin": "tsx --env-file=.env prisma/seed/super-admin.ts",
    "audit:notifications": "tsx --env-file=.env scripts/audit-notifications.ts",
    "audit:roles": "tsx --env-file=.env scripts/audit-roles.ts",
    "clean:demo": "tsx --env-file=.env scripts/remove-demo-data.ts"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
