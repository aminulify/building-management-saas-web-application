{
  "name": "amaderghor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:e2e": "tsx --env-file=.env scripts/smoke.ts",
    "db:seed": "tsx --env-file=.env prisma/seed/index.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed/demo-owner.ts"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
