model SubscriptionPlan {
  id                  String       @id @default(uuid(7)) @db.Uuid
  code                String       @unique
  nameBn              String
  nameEn              String
  audience            PlanAudience
  monthlyPrice        Decimal      @db.Decimal(12, 2)
  quarterlyDiscount   Decimal      @default(10) @db.Decimal(5, 2)
  yearlyDiscount      Decimal      @default(20) @db.Decimal(5, 2)
  propertyLimit       Int          @default(0)
  unitLimit           Int          @default(0)
  listingLimit        Int          @default(0)
  listingDurationDays Int          @default(30)
  features            Json         @default("{}")
  isActive            Boolean      @default(true)
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz

  history       PlanPriceHistory[]
  subscriptions UserSubscription[]
  requests      UpgradeRequest[]
}

model PlanPriceHistory {
  id          String           @id @default(uuid(7)) @db.Uuid
  planId      String           @db.Uuid
  field       String
  oldValue    String
  newValue    String
  effectiveAt DateTime         @default(now()) @db.Timestamptz
  changedById String           @db.Uuid
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

model UserSubscription {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @db.Uuid
  planId       String             @db.Uuid
  audience     PlanAudience
  planSnapshot Json
  cycle        BillingCycle
  amount       Decimal            @db.Decimal(12, 2)
  startsAt     DateTime?          @db.Timestamptz
  endsAt       DateTime?          @db.Timestamptz
  graceEndsAt  DateTime?          @db.Timestamptz
  status       SubscriptionStatus @default(PENDING)
  autoRenew    Boolean            @default(false)
  cancelledAt  DateTime?          @db.Timestamptz
  createdAt    DateTime           @default(now()) @db.Timestamptz

  user         User                 @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@index([userId, status])
  @@index([audience, status])
}

model UpgradeRequest {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @db.Uuid
  planId          String        @db.Uuid
  cycle           BillingCycle
  expectedAmount  Decimal       @db.Decimal(12, 2)
  quoteSnapshot   Json
  senderNumber    String
  trxId           String        @unique
  status          UpgradeStatus @default(PENDING)
  reviewerId      String?       @db.Uuid
  reviewedAt      DateTime?     @db.Timestamptz
  rejectionReason String?
  fromRole        Role
  toRole          Role
  createdAt       DateTime      @default(now()) @db.Timestamptz

  user         User                 @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@index([status, createdAt])
}

model PaymentTransaction {
  id               String            @id @default(uuid(7)) @db.Uuid
  userId           String            @db.Uuid
  purpose          PaymentPurpose
  subscriptionId   String?           @db.Uuid
  upgradeRequestId String?           @db.Uuid
  /// set when the payment is for a listing Boost (purpose PROMOTION)
  boostId          String?           @db.Uuid
  amount           Decimal           @db.Decimal(12, 2)
  gateway          PaymentGateway
  gatewayTxnId     String            @unique
  status           TransactionStatus @default(INITIATED)
  rawPayload       Json?
  verifiedAt       DateTime?         @db.Timestamptz
  refundAmount     Decimal?          @db.Decimal(12, 2)
  refundedAt       DateTime?         @db.Timestamptz
  refundReason     String?
  createdAt        DateTime          @default(now()) @db.Timestamptz

  user           User              @relation(fields: [userId], references: [id])
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id])
  upgradeRequest UpgradeRequest?   @relation(fields: [upgradeRequestId], references: [id])
  boost          ListingBoost?     @relation(fields: [boostId], references: [id])
  invoice        Invoice?

  /// Super Admin dashboard: revenue of a date range
  @@index([status, purpose, verifiedAt])
}

model Invoice {
  id            String             @id @default(uuid(7)) @db.Uuid
  transactionId String             @unique @db.Uuid
  number        String             @unique
  pdfKey        String?
  createdAt     DateTime           @default(now()) @db.Timestamptz
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])
}

/// A price/limit change that takes effect later (Super Admin "Schedule Change"). Applied by the daily job.
model ScheduledPlanChange {
  id          String    @id @default(uuid(7)) @db.Uuid
  planId      String    @db.Uuid
  changes     Json
  effectiveAt DateTime  @db.Timestamptz
  appliedAt   DateTime? @db.Timestamptz
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([appliedAt, effectiveAt])
}
