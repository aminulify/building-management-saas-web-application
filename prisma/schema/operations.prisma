model MaintenanceRequest {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// the number people say aloud: REQ-1001
  ticketNo       Int               @unique @default(autoincrement())
  agreementId    String            @db.Uuid
  unitId         String            @db.Uuid
  tenantId       String            @db.Uuid
  category       String
  title          String
  description    String
  priority       Priority          @default(MEDIUM)
  status         MaintenanceStatus @default(PENDING)
  technicianName String?
  /// the date and time the tenant would like the repair done
  preferredAt    DateTime?         @db.Timestamptz
  /// when it was marked Completed (cleared if it is reopened): the Super Admin report averages createdAt → resolvedAt
  resolvedAt     DateTime?         @db.Timestamptz
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  agreement RentalAgreement      @relation(fields: [agreementId], references: [id])
  unit      Unit                 @relation(fields: [unitId], references: [id])
  images    MaintenanceImage[]
  comments  MaintenanceComment[]

  @@index([unitId, status])
  @@index([tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model MaintenanceComment {
  id        String             @id @default(uuid(7)) @db.Uuid
  requestId String             @db.Uuid
  authorId  String             @db.Uuid
  body      String
  createdAt DateTime           @default(now()) @db.Timestamptz
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
}

model MaintenanceImage {
  id         String             @id @default(uuid(7)) @db.Uuid
  requestId  String             @db.Uuid
  storageKey String
  request    MaintenanceRequest @relation(fields: [requestId], references: [id])
}

model Complaint {
  id           String           @id @default(uuid(7)) @db.Uuid
  reporterId   String           @db.Uuid
  category     String
  subject      String
  description  String
  propertyId   String?          @db.Uuid
  assignedToId String?          @db.Uuid
  evidence     String[]         @default([])
  status       ComplaintStatus  @default(OPEN)
  resolution   String?
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz
  events       ComplaintEvent[]

  @@index([reporterId])
  @@index([assignedToId, status])
}

model ComplaintEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  complaintId String    @db.Uuid
  actorId     String    @db.Uuid
  action      String
  note        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  complaint   Complaint @relation(fields: [complaintId], references: [id])
}
