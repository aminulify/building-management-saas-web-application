model User {
  id                 String             @id @default(uuid(7)) @db.Uuid
  authId             String?            @unique
  username           String             @unique
  ownerCode          String?            @unique
  /// "TF100001": the Tenant ID every account gets at sign-up; it never changes, whatever the role becomes
  tenantCode         String?            @unique
  role               Role               @default(GENERAL_USER)
  status             UserStatus         @default(ACTIVE)
  fullName           String
  email              String?            @unique
  phone              String?            @unique
  nid                String?
  nidHash            String?            @unique
  nidLast4           String?
  dateOfBirth        DateTime?          @db.Date
  gender             String?
  avatarKey          String?
  occupation         String?
  addressId          String?            @db.Uuid
  verificationStatus VerificationStatus @default(UNVERIFIED)
  locale             String             @default("bn")
  preferences        Json               @default("{}")
  lastSeenAt         DateTime?          @db.Timestamptz
  /// set while the account is under a Super Admin warning (it can still sign in); cleared when it is set back to Active or Suspended
  warnedAt           DateTime?          @db.Timestamptz
  archivedAt         DateTime?          @db.Timestamptz
  archiveReason      String?
  /// Previous Owners page: SUBSCRIPTION_CANCELLED, POLICY_VIOLATION_FRAUD, BUSINESS_CLOSED, SOLD_ALL_PROPERTIES, ACCOUNT_DELETED_BY_USER, NON_PAYMENT, DORMANT, OWNER_REQUEST, OTHER
  archiveReasonCode  String?
  /// the day the account left the active lists (archived, banned, inactive or deleted); cleared on reactivation
  leftAt             DateTime?          @db.Timestamptz
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  address             Address?                 @relation(fields: [addressId], references: [id])
  ownerProfile        OwnerProfile?
  tenantProfile       TenantProfile?
  govAdminProfile     GovAdminProfile?
  permissionOverrides UserPermissionOverride[]
  subscriptions       UserSubscription[]
  upgradeRequests     UpgradeRequest[]
  transactions        PaymentTransaction[]
  properties          Property[]
  listings            Listing[]
  notifications       Notification[]
  boosts              ListingBoost[]
  statusLogs          AccountStatusLog[]       @relation("LogTarget")
  statusLogsMade      AccountStatusLog[]       @relation("LogAdmin")

  @@index([role, status])
  @@index([role, leftAt])
  /// Super Admin dashboard: the Active Plans list, filtered by role, newest first
  @@index([role, id(sort: Desc)])
}

model OwnerProfile {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @db.Uuid
  businessName String?
  /**
   * the bKash number tenants send rent to (shown in the tenant's Send Paid Request)
   */
  bkashNumber  String?
  addressId    String?  @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  address      Address? @relation(fields: [addressId], references: [id])
}

model TenantProfile {
  id               String  @id @default(uuid(7)) @db.Uuid
  userId           String  @unique @db.Uuid
  emergencyContact String?
  occupation       String?
  /// people living with the tenant ("Member" on the profile page)
  members          Int     @default(1)
  user             User    @relation(fields: [userId], references: [id])
}

model GovAdminProfile {
  id          String  @id @default(uuid(7)) @db.Uuid
  userId      String  @unique @db.Uuid
  department  String?
  designation String?
  createdById String? @db.Uuid
  user        User    @relation(fields: [userId], references: [id])
}

model UserPermissionOverride {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  permission  String
  granted     Boolean  @default(true)
  grantedById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, permission])
}

model Address {
  id         String         @id @default(uuid(7)) @db.Uuid
  division   String
  district   String
  upazila    String?
  area       String?
  street     String?
  union      String?
  postOffice String?
  postalCode String?
  properties Property[]
  owners     OwnerProfile[]
  users      User[]
}

model VerificationDocument {
  id         String             @id @default(uuid(7)) @db.Uuid
  ownerType  DocOwnerType
  ownerId    String             @db.Uuid
  kind       DocKind
  storageKey String
  status     VerificationStatus @default(PENDING)
  reviewerId String?            @db.Uuid
  notes      String?
  createdAt  DateTime           @default(now()) @db.Timestamptz

  @@index([ownerType, ownerId])
}

/// Permanent comment log of an account: every warning, suspension, restore and archive, with the reason, the admin and the time
model AccountStatusLog {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @db.Uuid
  adminId       String        @db.Uuid
  /// the admin's username when it was written (so the log still reads right if the account changes)
  adminUsername String
  action        AccountAction
  comment       String?
  createdAt     DateTime      @default(now()) @db.Timestamptz

  user  User @relation("LogTarget", fields: [userId], references: [id])
  admin User @relation("LogAdmin", fields: [adminId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}
